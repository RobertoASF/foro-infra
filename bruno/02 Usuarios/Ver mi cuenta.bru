meta {
  name: Ver mi cuenta
  type: http
  seq: 8
}

get {
  url: {{usuarios}}/api/usuarios/{{idCamila}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenCamila}}
}

tests {
  test("cada usuario puede ver su propia cuenta", function () {
    expect(res.status).to.equal(200);
    expect(res.body.nombreUsuario).to.equal("camila");
  });
}
