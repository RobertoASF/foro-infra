meta {
  name: Listar roles
  type: http
  seq: 14
}

get {
  url: {{usuarios}}/api/roles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("muestra los tres roles con su total de usuarios", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.equal(3);
    expect(res.body[0]).to.have.property("totalUsuarios");
  });
}
