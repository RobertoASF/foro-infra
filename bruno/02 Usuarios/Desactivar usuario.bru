meta {
  name: Desactivar usuario
  type: http
  seq: 12
}

put {
  url: {{usuarios}}/api/usuarios/{{idNuevo}}/estado
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "activo": false
  }
}

tests {
  test("deja la cuenta inactiva", function () {
    expect(res.status).to.equal(200);
    expect(res.body.activo).to.equal(false);
  });
}
