meta {
  name: Filtrar usuarios por rol
  type: http
  seq: 5
}

get {
  url: {{usuarios}}/api/usuarios?rol=moderador
  body: none
  auth: bearer
}

params:query {
  rol: moderador
}

auth:bearer {
  token: {{tokenAdmin}}
}

tests {
  test("devuelve solo moderadores", function () {
    expect(res.status).to.equal(200);
    expect(res.body.length).to.be.at.least(1);
    res.body.forEach((usuario) => expect(usuario.rol).to.equal("MODERADOR"));
  });
}
