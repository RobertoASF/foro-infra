meta {
  name: Moderador borra tema ajeno
  type: http
  seq: 7
}

delete {
  url: {{publicaciones}}/api/temas/{{idTema}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenModerador}}
}

tests {
  test("el moderador puede borrarlo", function () {
    expect(res.status).to.equal(200);
    expect(res.body.mensaje).to.equal("Tema eliminado");
  });
}
