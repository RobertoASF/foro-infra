meta {
  name: Ver tema con comentarios
  type: http
  seq: 4
}

get {
  url: {{publicaciones}}/api/temas/{{idTema}}
  body: none
  auth: none
}

tests {
  test("trae el tema junto a sus comentarios", function () {
    expect(res.status).to.equal(200);
    expect(res.body.tema.totalComentarios).to.equal(1);
    expect(res.body.comentarios.length).to.equal(1);
  });
}
