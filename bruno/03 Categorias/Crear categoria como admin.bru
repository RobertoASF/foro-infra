meta {
  name: Crear categoria como admin
  type: http
  seq: 3
}

post {
  url: {{publicaciones}}/api/categorias
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
    "nombre": "{{nombreCategoria}}",
    "descripcion": "Categoría creada desde Bruno"
  }
}

script:pre-request {
  bru.setVar("nombreCategoria", "Viajes " + Date.now());
}

vars:post-response {
  idCategoriaNueva: res.body.id
}

tests {
  test("crea la categoria", function () {
    expect(res.status).to.equal(201);
    expect(res.body.id).to.be.a("number");
  });
}
