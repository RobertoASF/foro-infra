meta {
  name: Login admin
  type: http
  seq: 1
}

post {
  url: {{usuarios}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuario": "admin",
    "password": "{{clave}}"
  }
}

vars:post-response {
  tokenAdmin: res.body.token
}

tests {
  test("entrega un token con rol ADMIN", function () {
    expect(res.status).to.equal(200);
    expect(res.body.tipo).to.equal("Bearer");
    expect(res.body.usuario.rol).to.equal("ADMIN");
  });
}
