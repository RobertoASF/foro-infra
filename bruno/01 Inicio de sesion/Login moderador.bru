meta {
  name: Login moderador
  type: http
  seq: 2
}

post {
  url: {{usuarios}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "nombreUsuario": "moderador",
    "password": "{{clave}}"
  }
}

vars:post-response {
  tokenModerador: res.body.token
}

tests {
  test("entrega un token con rol MODERADOR", function () {
    expect(res.status).to.equal(200);
    expect(res.body.usuario.rol).to.equal("MODERADOR");
  });
}
