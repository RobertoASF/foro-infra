# Copia este archivo como .env y cambia los valores

# Datos del Wallet de Oracle Cloud
DB_ALIAS=dbfullstack3_tp
WALLET_DIR=Wallet_dbfullstack3

# Clave de ADMIN: solo se usa para crear los esquemas la primera vez
ORACLE_ADMIN_PASSWORD=cambia_esta_clave

# Claves de los esquemas: de 12 a 30 caracteres, con mayúscula, minúscula y número
DB_USUARIOS_PASSWORD=cambia_esta_clave
DB_PUBLICACIONES_PASSWORD=cambia_esta_clave

JWT_SECRETO=cambia_esta_clave_por_una_de_al_menos_32_caracteres
CORS_ORIGEN=http://localhost:3000
